<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><AssemblyName>Unity.InputSystem</AssemblyName>
    <!-- Extracted com.unity.inputsystem-1.20.0.tgz (from <Unity>/Editor/Data/Resources/PackageManager/Editor). -->
    <InputSystemPackage Condition="'$(InputSystemPackage)' == ''">$(MSBuildThisFileDirectory)../.packages/inputsystem/package</InputSystemPackage><DefineConstants>$(DefineConstants);UNITY_INPUT_SYSTEM_ENABLE_UI;UNITY_INPUT_SYSTEM_ENABLE_PHYSICS;UNITY_INPUT_SYSTEM_INPUT_MODULE_SCROLL_DELTA;UNITY_INPUT_SYSTEM_INPUT_MODULE_NAVIGATION_DEVICE_TYPE;UNITY_INPUT_SYSTEM_SENDPOINTERHOVERTOPARENT;UNITY_INPUT_SYSTEM_PLATFORM_SCROLL_DELTA;UNITY_INPUTSYSTEM_SUPPORTS_MOUSE_SCRIPT_EVENTS;UNITY_INPUTSYSTEM_SUPPORTS_FOCUS_EVENTS;UNITY_INPUT_SYSTEM_PLATFORM_POLLING_FREQUENCY</DefineConstants></PropertyGroup>
  <ItemGroup><Compile Include="$(InputSystemPackage)/InputSystem/**/*.cs" Exclude="$(InputSystemPackage)/InputSystem/Editor/**;$(InputSystemPackage)/InputSystem/**/Editor/**;$(InputSystemPackage)/InputSystem/Runtime/Plugins/InputForUI/**" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../UGUI/UGUI.csproj" />
  </ItemGroup>
</Project>
