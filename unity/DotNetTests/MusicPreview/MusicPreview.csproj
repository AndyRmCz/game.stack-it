<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Renders every soundtrack to WAV files with the game's own music code, so they can be heard
    without Unity. See Program.cs for how to run it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Logic/StackIt.Logic.csproj" />
  </ItemGroup>
</Project>
