  - m_Id: 8463048751
    m_Localized: Regalo diario
    m_Metadata:
      m_Items: []
  - m_Id: 8463048752
    m_Localized: "Vuelve cada d\xEDa: el regalo crece hasta el d\xEDa 7. Si fallas
      un d\xEDa empieza de nuevo."
    m_Metadata:
      m_Items: []
  - m_Id: 8463048753
    m_Localized: Reclamar
    m_Metadata:
      m_Items: []
  - m_Id: 8463048754
    m_Localized: Te esperan {0} monedas
    m_Metadata:
      m_Items: []
  - m_Id: 8463048755
    m_Localized: "Vuelve ma\xF1ana por el siguiente regalo"
    m_Metadata:
      m_Items: []
  - m_Id: 8463048756
    m_Localized: "D\xEDa {0}"
    m_Metadata:
      m_Items: []
