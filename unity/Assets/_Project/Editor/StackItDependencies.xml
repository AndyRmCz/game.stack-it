<?xml version="1.0" encoding="utf-8"?>
<!--
  Native dependencies of the Stack IT plugins, resolved by the External Dependency Manager for
  Unity (EDM4U, installed together with the Google Mobile Ads plugin).
  Android: Assets/Plugins/Android/*.java   iOS: Assets/Plugins/iOS/*.mm
-->
<dependencies>
  <androidPackages>
    <!-- FileProvider for sharing clips. -->
    <androidPackage spec="androidx.core:core:1.13.1" />
    <!-- Challenge code through fresh installs. -->
    <androidPackage spec="com.android.installreferrer:installreferrer:2.2" />
    <!-- Sign in with Google (Credential Manager). -->
    <androidPackage spec="androidx.credentials:credentials:1.3.0" />
    <androidPackage spec="androidx.credentials:credentials-play-services-auth:1.3.0" />
    <androidPackage spec="com.google.android.libraries.identity.googleid:googleid:1.1.1" />
  </androidPackages>
  <iosPods>
    <iosPod name="GoogleSignIn" version="~> 7.1" addToAllTargets="false" />
  </iosPods>
</dependencies>
