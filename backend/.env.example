# Copy to backend/.env for running the API outside docker compose.
# Every variable is documented in SETUP.md (section 3), including production values.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Railway provides DATABASE_URL as postgresql://...; the app adds the asyncpg driver itself.
DATABASE_URL=postgresql+asyncpg://stackit:stackit@localhost:5432/stackit
# Read by pytest from the process environment (this value is the default). Its public schema is
# dropped on every run, so the database name must end in "_test".
TEST_DATABASE_URL=postgresql+asyncpg://stackit:stackit@localhost:5432/stackit_test

# Every public link (challenge URLs, OG tags, well-known files) is built from this.
PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated. Leave empty: the client is a native app, not a browser.
CORS_ALLOWED_ORIGINS=

APP_BUNDLE_ID=com.milli.game
APP_URL_SCHEME=milli

# Required in production: 32+ random characters (python -c "import secrets; print(secrets.token_urlsafe(48))").
# JWT_SECRET=  (unset locally: a dev-only default is used)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# Sign-in. Google: comma-separated OAuth client IDs (web client ID used by Android + iOS client ID).
GOOGLE_CLIENT_IDS=
# Apple: defaults to APP_BUNDLE_ID when empty.
APPLE_CLIENT_IDS=

RUN_TTL_HOURS=48
CHALLENGE_TTL_DAYS=7
RATE_LIMIT_ENABLED=true

# Deep links and store pages.
APPLE_TEAM_ID=
ANDROID_SHA256_FINGERPRINTS=
IOS_APP_STORE_URL=
ANDROID_PLAY_STORE_URL=
ADMOB_PUBLISHER_ID=
SUPPORT_EMAIL=support@example.com
